+
+// Portable mode. If set, all app data, settings and temporary files are stored under this
+// single directory instead of the per-user platform locations, so the app leaves nothing
+// behind in the user profile and can live entirely on a removable drive.
+//
+// Resolution order:
+//   1. SIMPLEX_DATA_DIR environment variable
+//   2. -Dsimplex.data.dir=... JVM property
+//   3. a `portable` marker file or directory placed next to the app launcher
+//      (jpackage sets jpackage.app-path; falls back to the Compose resources directory)
+val simplexDataDirOverride: String? by lazy {
+  val explicit = (System.getenv("SIMPLEX_DATA_DIR") ?: System.getProperty("simplex.data.dir"))
+    ?.trim()
+    ?.takeIf { it.isNotEmpty() }
+  explicit ?: portableMarkerDir()
+}
+
+private fun portableMarkerDir(): String? {
+  val launcherDir =
+    System.getProperty("jpackage.app-path")?.let { File(it).absoluteFile.parentFile }
+      ?: System.getProperty("compose.application.resources.dir")?.let { File(it).absoluteFile.parentFile?.parentFile }
+      ?: return null
+  return if (File(launcherDir, "portable").exists()) File(launcherDir, "data").absolutePath else null
+}
+
+private val unixConfigPath = simplexDataDirOverride ?: ((System.getenv("XDG_CONFIG_HOME") ?: "$home/.config") + "/simplex")
+private val unixDataPath = simplexDataDirOverride ?: ((System.getenv("XDG_DATA_HOME") ?: "$home/.local/share") + "/simplex")
+private val windowsPath = simplexDataDirOverride ?: (System.getenv("AppData") + File.separator + "SimpleX")
 val desktopPlatform = detectDesktopPlatform()
 
